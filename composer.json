{
    "name": "glial/pmacontrol",
    "license": "GPL-3.0",
    "description": "A monitoring and administration tools to manage farm of MySQL server",
    "authors": [
        {
            "name": "Aur\u00e9lien LEQUOY",
            "email": "pmacontrol@68koncept.com",
            "homepage": "http://pmacontrol.68koncept.com",
            "role": "Expert MySQL / MariaDB"
        }
    ],
    "require": {
        "php": ">7",
        "ext-gd": "*",
        "ext-mysqlnd": "*",
        "ext-curl": "*",
        "ext-mbstring": "*",
        "ext-dom": "*",
        "ext-gmp": "*",
        "ext-sodium": "*",
        "glial/glial": "5.1.41",
        "sensiolabs/ansi-to-html": "1.3.0",
        "alfallouji/php_multithread": "0.1.4",
        "esysteme/mysql-sys": "1.6.*",
        "ninsuo/php-shared-memory": "*",
        "geerlingguy/ping": "*",
        "ramsey/uuid": "^4.7",
        "jfcherng/php-diff": "^6.2",
        "phpmyadmin/sql-parser": "^5.1",
        "phpseclib/phpseclib": "~3.0",
        "geoip2/geoip2": "^3.2",
        "doctrine/sql-formatter": "^1.5",
        "matomo/device-detector": "^6.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "App/",
            "Glial\\": "Glial/"
        },
        "files": [
            "App/Library/SqlFormatterCompat.php",
            "App/Library/LdapEncodingCompat.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5.50"
    }
}
